# ============================================================
# Epic Kiosk 环境变量配置文件
# ============================================================
# 复制此文件为 .env 并填写你的配置
# cp .env.example .env
# ============================================================


# 获取地址: https://cloud.siliconflow.cn/i/OVI2n57p

AI-API-KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
API_PROVIDER=siliconflow # API 提供商
AI_BASE_URL=https://api.siliconflow.cn/v1 # API 提供商 兼容OPENAI URL

CAPTCHA_MODEL=glm-4.6v-flash  # 图形验证码模型
CAPTCHA_MODEL_FALLBACK=glm-ocr # 图形验证码模型（备用）
PRIMARY_MODEL=glm-4.7-flash   # 主模型
PRIMARY_MODEL_FALLBACK=glm-ocr # 主模型（备用）
    